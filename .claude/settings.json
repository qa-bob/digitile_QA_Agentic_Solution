{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx playwright *)",
      "Bash(npx tsc *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(npm publish *)",
      "Bash(npm run deploy *)",
      "Bash(git push --force *)",
      "Bash(rm -rf *)",
      "Bash(curl * | bash)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "autoMemoryEnabled": true,
  "fileCheckpointingEnabled": true,
  "includeGitInstructions": true,
  "attribution": {
    "commit": "Co-Authored-By: Claude Code <noreply@anthropic.com>"
  }
}
